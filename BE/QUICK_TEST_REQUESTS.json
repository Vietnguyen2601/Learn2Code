{
  "test_cases": [
    {
      "name": "RUN FLOW - Correct Implementation",
      "type": "POST",
      "url": "http://localhost:5049/api/exercises/{{exerciseId}}/run",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "code": "public class Solution {\n    public static int add(int a, int b) {\n        return a + b;\n    }\n}",
        "language": "java"
      },
      "expected": {
        "success": true,
        "data": {
          "output": "8",
          "runtimeMs": "~150ms"
        }
      }
    },
    {
      "name": "SUBMIT FLOW - Correct Implementation",
      "type": "POST",
      "url": "http://localhost:5049/api/exercises/{{exerciseId}}/submit",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "code": "public class Solution {\n    public static int add(int a, int b) {\n        return a + b;\n    }\n}",
        "language": "java"
      },
      "expected": {
        "success": true,
        "data": {
          "isPassed": true,
          "results": [
            {
              "testcaseId": "...",
              "isPassed": true,
              "actualOutput": "8"
            },
            {
              "testcaseId": "...",
              "isPassed": true,
              "actualOutput": "0"
            },
            {
              "testcaseId": "...",
              "isPassed": true,
              "actualOutput": "100"
            }
          ]
        }
      }
    },
    {
      "name": "SUBMIT FLOW - Wrong Implementation (Subtraction)",
      "type": "POST",
      "url": "http://localhost:5049/api/exercises/{{exerciseId}}/submit",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "code": "public class Solution {\n    public static int add(int a, int b) {\n        return a - b;\n    }\n}",
        "language": "java"
      },
      "expected": {
        "success": true,
        "data": {
          "isPassed": false,
          "results": [
            {
              "isPassed": false,
              "actualOutput": "2"
            },
            {
              "isPassed": false,
              "actualOutput": "-20"
            },
            {
              "isPassed": false,
              "actualOutput": "0"
            }
          ]
        }
      }
    }
  ]
}
